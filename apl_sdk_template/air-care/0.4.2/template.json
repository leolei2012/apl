      "requires": [
        "purify"
      ],
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_SENSOR_HCHO"
        }
      ]
    },
    {
      "key": "sensor_tvoc",
      "name": "TVOC输入",
      "description": "TVOC输入",
      "enabledByDefault": false,
      "definition": {
        "id": "template_sensor_tvoc",
        "key": "sensor_tvoc",
        "name": "TVOC输入",
        "description": "",
        "kind": "bool",
        "access": "read",
        "default": true,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "requires": [
        "purify"
      ],
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_SENSOR_TVOC"
        }
      ]
    },
    {
      "key": "sensor_ready",
      "name": "有效输入标记",
      "description": "有效输入标记",
      "enabledByDefault": true,
      "definition": {
        "id": "template_sensor_ready",
        "key": "sensor_ready",
        "name": "有效输入标记",
        "description": "",
        "kind": "int",
        "access": "read",
        "default": 0,
        "unit": "",
        "min": 0,
        "max": 31,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "required": true
    },
    {
      "key": "sensor_faults",
      "name": "传感器故障标记",
      "description": "传感器故障标记",
      "enabledByDefault": true,
      "definition": {
        "id": "template_sensor_faults",
        "key": "sensor_faults",
        "name": "传感器故障标记",
        "description": "",
        "kind": "int",
        "access": "read",
        "default": 0,
        "unit": "",
        "min": 0,
        "max": 31,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "required": true
    },
    {
      "key": "module_faults",
      "name": "模块故障标记",
      "description": "模块故障标记",
      "enabledByDefault": true,
      "definition": {
        "id": "template_module_faults",
        "key": "module_faults",
        "name": "模块故障标记",
        "description": "",
        "kind": "int",
        "access": "read",
        "default": 0,
        "unit": "",
        "min": 0,
        "max": 7,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "required": true
    }
  ],
  "parameters": [
    {
      "key": "tick_ms",
      "name": "业务推进周期",
      "description": "当前 APL C 库固定每 10 ms 推进一次。",
      "kind": "int",
      "default": 10,
      "min": 10,
      "max": 10,
      "step": 1,
      "unit": "ms"
    },
    {
      "key": "filter_life_h",
      "name": "滤芯寿命",
      "description": "影响滤芯累计时长与维护提醒。",
      "kind": "int",
      "default": 2200,
      "min": 1,
      "max": 1000000,
      "step": 1,
      "unit": "小时",
      "binding": {
        "path": "config/apl_core_config.h",
        "macro": "APL_CORE_FILTER_LIFE_H"
      }
    },
    {
      "key": "dry_seconds",
      "name": "风干时长",
      "description": "加湿机型关机后，风机继续运行的时长。",
      "kind": "int",
      "default": 3600,
      "min": 1,
      "max": 86400,
      "step": 1,
      "unit": "秒",
      "requires": [
        "humidify"
      ],
      "binding": {
        "path": "config/apl_core_config.h",
        "macro": "APL_CORE_DRY_S"
      }
    },
    {
      "key": "dry_fan_gear",
      "name": "风干档位",
      "description": "关机风干期间的实际输出档位。",
      "kind": "enum",
      "default": 1,
      "options": [
        {
          "label": "一档",
          "value": 1
        },
        {
          "label": "二档",
          "value": 2
        },
        {
          "label": "三档",
          "value": 3
        }
      ],
      "requires": [
        "humidify"
      ],
      "binding": {
        "path": "config/apl_core_config.h",
        "macro": "APL_CORE_DRY_FAN_GEAR"
      }
    },
    {
      "key": "humidity_hysteresis",
      "name": "恒湿回差",
      "description": "低于目标湿度相应百分点后恢复加湿。",
      "kind": "int",
      "default": 3,
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "百分点",
      "requires": [
        "humidity"
      ],
      "binding": {
        "path": "config/apl_core_config.h",
        "macro": "APL_CORE_HUMIDITY_HYSTERESIS"
      }
    },
    {
      "key": "turbo_enabled",
      "name": "风速键长按进入极速",
      "description": "开启时长按3秒进入/退出极速；关闭时长按不改变档位，短按循环保持不变。",
      "kind": "bool",
      "default": true,
      "binding": {
        "path": "config/apl_core_config.h",
        "macro": "APL_CORE_HAS_TURBO"
      }
    },
    {
      "key": "sensor_fallback_gear",
      "name": "传感器无效时备用档（项目确认）",
      "description": "缺省二档仅延续旧加湿缺省；项目必须确认。预处理期间使用开机物理档。",
      "kind": "enum",
      "default": 2,
      "options": [
        {
          "label": "睡眠风速",
          "value": 0
        },
        {
          "label": "一档",
          "value": 1
        },
        {
          "label": "二档",
          "value": 2
        },
        {
          "label": "三档",
          "value": 3
        }
      ],
      "binding": {
        "path": "config/apl_core_config.h",
        "macro": "APL_CORE_SENSOR_FALLBACK_GEAR"
      }
    }
  ],
  "ports": [
    {
      "key": "get_key_state",
      "name": "六键采样",
      "signature": "void get_key_state(struct apl_hmi_key_state *state, void *ctx)",
      "description": "提供已消抖的六键电平。",
      "required": true,
      "requires": []
    },
    {
      "key": "set_fan",
      "name": "风机输出",
      "signature": "void set_fan(enum apl_switch state, enum apl_fan_gear gear, void *ctx)",
      "description": "将输出档位映射到本项目的风机驱动。",
      "required": true,
      "requires": []
    },
    {
      "key": "get_pm25",
      "name": "空气质量采样",
      "signature": "uint16_t get_pm25(void *ctx)",
      "description": "返回 PM2.5 整数 μg/m³。",
      "required": true,
      "requires": [
        "pm25"
      ]
    },
    {
      "key": "get_uv_interlock",
      "name": "UV 安全联锁",
      "signature": "uint8_t get_uv_interlock(void *ctx)",
      "description": "闭合返回 1，未接线时禁止 UV。",
      "required": true,
      "requires": [
        "uv"
      ]
    },
    {
      "key": "set_uv",
      "name": "UV 输出",
      "signature": "void set_uv(enum apl_switch state, void *ctx)",
      "description": "实现受安全联锁控制的 UV 输出。",
      "required": true,
      "requires": [
        "uv"
      ]
    },
    {
      "key": "set_anion",
      "name": "负离子输出",
      "signature": "void set_anion(enum apl_switch state, void *ctx)",
      "description": "实现负离子开关。",
      "required": true,
      "requires": [
        "anion"
      ]
    },
    {
      "key": "get_water_level",
      "name": "水位采样",
      "signature": "enum apl_water_level get_water_level(void *ctx)",
      "description": "返回 0–4 段，0 表示缺水。",
      "required": true,
      "requires": [
        "humidify"
      ]
    },
    {
      "key": "get_humidity",
      "name": "湿度采样",
      "signature": "uint8_t get_humidity(void *ctx)",
      "description": "返回 0–100% 的实际环境湿度。",
      "required": true,
      "requires": [
        "humidity"
      ]
    },
    {
      "key": "set_pump",
      "name": "加湿负载输出",
      "signature": "void set_pump(enum apl_switch state, void *ctx)",
      "description": "实现水泵或雾化负载。",
      "required": true,
      "requires": [
        "humidify"
      ]
    },
    {
      "key": "set_buzzer",
      "name": "蜂鸣器输出",
      "signature": "void set_buzzer(uint8_t on, void *ctx)",
      "description": "按需实现面板提示音。",
      "required": false,
      "requires": []
    },
    {
      "key": "memory_save",
      "name": "记忆保存",
      "signature": "void memory_save(const struct apl_core_memory *memory, void *ctx)",
      "description": "按字段编码并带版本与校验保存，初始化后显式恢复。",
      "required": false,
      "requires": []
    },
    {
      "key": "get_sensor_status",
      "name": "传感器输入状态",
      "signature": "enum apl_sensor_status get_sensor_status(enum apl_sensor sensor, void *ctx)",
      "description": "驱动缓存ABSENT/WARMUP/VALID/FAULT；开短路、超时和持续越界阈值由项目确认。启用传感器时应显式实现，不能把占位值当有效样本。",
      "required": false
    },
    {
      "key": "get_module_fault",
      "name": "模块故障反馈",
      "signature": "uint8_t get_module_fault(enum apl_module module, void *ctx)",
      "description": "宿主已确认故障，0正常非0故障。NULL表示未提供反馈，不代表已检测；板间协议和消抖参数待项目定义。",
      "required": false
    },
    {
      "key": "get_pm10",
      "name": "PM10输入",
      "requires": [
        "sensor_pm10"
      ],
      "signature": "uint16_t get_pm10(void *ctx)",
      "required": true,
      "description": "整数μg/m³，传感器状态由get_sensor_status分别报告；未装配保持NULL，不以0代替未接入。"
    },
    {
      "key": "get_hcho",
      "name": "甲醛输入",
      "requires": [
        "sensor_hcho"
      ],
      "signature": "uint16_t get_hcho(void *ctx)",
      "required": true,
      "description": "整数μg/m³，传感器状态由get_sensor_status分别报告；未装配保持NULL，不以0代替未接入。"
    },
    {
      "key": "get_tvoc",
      "name": "TVOC输入",
      "requires": [
        "sensor_tvoc"
      ],
      "signature": "uint16_t get_tvoc(void *ctx)",
      "required": true,
      "description": "整数μg/m³，传感器状态由get_sensor_status分别报告；未装配保持NULL，不以0代替未接入。"
    }
  ],
  "constraints": [
    {
      "kind": "atLeastOne",
      "features": [
        "purify",
        "humidify"
      ],
      "message": "净化与加湿至少启用一项。"
    }
  ],
  "directories": [
    "src",
    "include",
    "config",
    "port",
    "examples",
    "verification"
  ],
  "staticFiles": [
    "CMakeLists.txt",
    "source-snapshot.json"
  ],
  "adapter": "adapter.json",
  "verification": {
    "sourceDirectories": [
      "src",
      "port",
      "examples"
    ],
    "includeDirectories": [
      "include",
      "config",
      "port"
