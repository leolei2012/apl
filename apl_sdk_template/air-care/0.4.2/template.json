{
  "formatVersion": 1,
  "id": "apl.air-care",
  "version": "0.4.2",
  "name": "净化加湿标准方案：选配与输入状态",
  "description": "三能力组合、独立UV/负离子/Wi-Fi和传感器配置；明确输入状态、定时/面板验收。未决规则、物理适配与故障判定参数仍需确认。 补丁：睡眠熄屏后保留Sleep指示灯；其他灯位冲突仍待确认。 周期保存通知跳过未启用计数，未设计真实NVM。",
  "definitionSchemaVersion": 1,
  "sourceVersion": "0.2.2",
  "features": [
    {
      "key": "power",
      "name": "电源",
      "description": "运行时按泵输出历史决定风干；风干中再次开机恢复运行。",
      "enabledByDefault": true,
      "definition": {
        "id": "template_power",
        "key": "power",
        "name": "电源",
        "description": "",
        "kind": "bool",
        "access": "readwrite",
        "default": false,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "required": true
    },
    {
      "key": "fan_speed",
      "name": "风机档位",
      "description": "风机档位",
      "enabledByDefault": true,
      "definition": {
        "id": "template_fan_speed",
        "key": "fan_speed",
        "name": "风机档位",
        "description": "",
        "kind": "enum",
        "access": "readwrite",
        "default": 1,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": [
          {
            "label": "睡眠",
            "value": 0
          },
          {
            "label": "一档",
            "value": 1
          },
          {
            "label": "二档",
            "value": 2
          },
          {
            "label": "三档",
            "value": 3
          },
          {
            "label": "自动",
            "value": 4
          },
          {
            "label": "极速",
            "value": 5
          }
        ]
      },
      "required": true,
      "defaultBinding": {
        "path": "config/apl_core_config.h",
        "macro": "APL_DEFAULT_FAN_GEAR"
      }
    },
    {
      "key": "purify",
      "name": "净化",
      "description": "净化复合功能开关，控制 UV 与负离子；硬件 UV 受安全联锁控制。",
      "enabledByDefault": true,
      "definition": {
        "id": "template_purify",
        "key": "purify",
        "name": "净化",
        "description": "",
        "kind": "bool",
        "access": "readwrite",
        "default": false,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_PURIFY"
        },
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_DEFAULT_PURIFY"
        }
      ]
    },
    {
      "key": "humidify",
      "name": "加湿",
      "description": "加湿开关，包含缺水保护、恒湿和关机风干。",
      "enabledByDefault": true,
      "definition": {
        "id": "template_humidify",
        "key": "humidify",
        "name": "加湿",
        "description": "",
        "kind": "bool",
        "access": "readwrite",
        "default": true,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_HUMIDIFY"
        },
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_DEFAULT_HUMIDIFY"
        }
      ]
    },
    {
      "key": "humidity",
      "name": "环境湿度",
      "description": "实际值由 get_humidity 硬件回调提供；默认值仅用于数据模型预览。",
      "enabledByDefault": true,
      "definition": {
        "id": "template_humidity",
        "key": "humidity",
        "name": "环境湿度",
        "description": "",
        "kind": "int",
        "access": "read",
        "default": 55,
        "unit": "%",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "requires": [
        "humidify"
      ],
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_SENSOR_HUMIDITY"
        }
      ]
    },
    {
      "key": "pm25",
      "name": "PM2.5",
      "description": "实际值由 get_pm25 硬件回调提供，单位 μg/m³。",
      "enabledByDefault": true,
      "definition": {
        "id": "template_pm25",
        "key": "pm25",
        "name": "PM2.5",
        "description": "",
        "kind": "int",
        "access": "read",
        "default": 28,
        "unit": "μg/m³",
        "min": 0,
        "max": 65535,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "requires": [
        "purify"
      ],
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_SENSOR_PM25"
        }
      ]
    },
    {
      "key": "drying",
      "name": "风干状态",
      "description": "只读关机风干状态，实际行为由 APL 执行。",
      "enabledByDefault": true,
      "definition": {
        "id": "template_drying",
        "key": "drying",
        "name": "风干状态",
        "description": "",
        "kind": "bool",
        "access": "read",
        "default": false,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "requires": [
        "humidify"
      ]
    },
    {
      "key": "uv",
      "name": "UV模块",
      "description": "UV模块",
      "enabledByDefault": true,
      "definition": {
        "id": "template_uv",
        "key": "uv",
        "name": "UV模块",
        "description": "",
        "kind": "bool",
        "access": "readwrite",
        "default": false,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_UV"
        }
      ]
    },
    {
      "key": "anion",
      "name": "负离子模块",
      "description": "负离子模块",
      "enabledByDefault": true,
      "definition": {
        "id": "template_anion",
        "key": "anion",
        "name": "负离子模块",
        "description": "",
        "kind": "bool",
        "access": "readwrite",
        "default": false,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_ANION"
        }
      ]
    },
    {
      "key": "wifi",
      "name": "Wi-Fi模块",
      "description": "Wi-Fi模块",
      "enabledByDefault": true,
      "definition": {
        "id": "template_wifi",
        "key": "wifi",
        "name": "Wi-Fi模块",
        "description": "",
        "kind": "enum",
        "access": "read",
        "default": 0,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": [
          {
            "label": "未连接",
            "value": 0
          },
          {
            "label": "配网中",
            "value": 1
          },
          {
            "label": "已连接",
            "value": 2
          }
        ]
      },
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_WIFI"
        }
      ]
    },
    {
      "key": "sensor_pm10",
      "name": "PM10输入",
      "description": "PM10输入",
      "enabledByDefault": false,
      "definition": {
        "id": "template_sensor_pm10",
        "key": "sensor_pm10",
        "name": "PM10输入",
        "description": "",
        "kind": "bool",
        "access": "read",
        "default": true,
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "maxLength": 64,
        "options": []
      },
      "requires": [
        "purify"
      ],
      "enabledBindings": [
        {
          "path": "config/apl_core_config.h",
          "macro": "APL_COMPILE_SENSOR_PM10"
        }
      ]
    },
    {
      "key": "sensor_hcho",
      "name": "甲醛输入",
      "description": "甲醛输入",
      "enabledByDefault": false,
      "definition": {
        "id": "template_sensor_hcho",
        "key": "sensor_hcho",
        "name": "甲醛输入",
        "description": "",
        "kind": "bool",
        "access": "read",
        "default": true,
        "unit": "",
        "min": 0,
