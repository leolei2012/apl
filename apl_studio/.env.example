# Copy to .env and fill these three values before public deployment.
# npm start does not read .env automatically. See deploy/README.md.
# Example origin: https://apl.example.com (root path; no /apl prefix).
APL_STUDIO_PUBLIC_URL=
APL_STUDIO_USERNAME=
# Use a unique generated password. Single quotes preserve $ in Compose files.
APL_STUDIO_PASSWORD=

# Bare Node behind an HTTPS reverse proxy uses loopback by default.
# compose.yaml overrides its container listener to 0.0.0.0.
# Its container port and loopback host mapping are fixed to 9190 as well.
APL_STUDIO_HOST=127.0.0.1
APL_STUDIO_PORT=9190

# Optional: keep data and compiler paths outside the source checkout.
# APL_STUDIO_DATA=/var/lib/apl-studio
# APL_STUDIO_CC=/usr/bin/gcc
